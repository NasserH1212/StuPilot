{
  "name": "studenthub-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual, Arabic-first StudentHub AI production foundation.",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test": "npm run test:unit && npm run test:component && npm run test:a11y",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:a11y": "vitest run tests/accessibility",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:generate": "node scripts/run-prisma.mjs generate",
    "db:validate": "node scripts/run-prisma.mjs validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:test:migrate": "node scripts/run-prisma-test.mjs migrate deploy",
    "db:test:status": "node scripts/run-prisma-test.mjs migrate status",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run boundaries && npm run typecheck && npm test && npm run build && npm run secrets:scan && npm run audit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.3.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.13.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
