# Copy to .env.local and replace only with local, non-production values.
# These credentials and database names are intentionally local-only examples.
NEXT_PUBLIC_APP_ENV=local
DATABASE_URL=postgresql://studenthub_dev:local-only-dev@127.0.0.1:5432/studenthub_dev
TEST_DATABASE_URL=postgresql://studenthub_test:local-only-test@127.0.0.1:5433/studenthub_test

# Production authentication is disabled unless this complete group is configured.
# Use real values only in an ignored .env.local or an approved secret store.
AUTH_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AUTH_STATE_SECRET=
