generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserAccountState {
  active
  disabled
  deletion_pending

  @@map("user_account_state")
}

model User {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state      UserAccountState @default(active)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  identities        AuthIdentity[]
  terms             Term[]
  profile           UserProfile?
  courses           Course[]
  courseEnrollments UserCourse[]
  classSeries       RecurringClassSeries[]

  @@map("users")
}

model AuthIdentity {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  provider              String   @db.VarChar(64)
  providerSubject       String   @map("provider_subject") @db.VarChar(255)
  verifiedEmailSnapshot String?  @map("verified_email_snapshot") @db.VarChar(320)
  emailVerifiedAt       DateTime @map("email_verified_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerSubject], map: "auth_identities_provider_subject_key")
  @@index([userId], map: "auth_identities_user_id_idx")
  @@map("auth_identities")
}

model Term {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  name              String       @db.VarChar(120)
  startsOn          DateTime     @map("starts_on") @db.Date
  endsOn            DateTime     @map("ends_on") @db.Date
  timeZone          String       @map("time_zone") @db.VarChar(64)
  isActive          Boolean      @default(false) @map("is_active")
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(3)
  version           Int          @default(0)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  courseEnrollments UserCourse[]

  @@unique([id, userId], map: "academic_terms_id_user_id_key")
  @@index([userId, archivedAt, startsOn, endsOn], map: "academic_terms_user_id_idx")
  @@map("academic_terms")
}

model Course {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  name            String       @db.VarChar(120)
  code            String?      @db.VarChar(32)
  colorToken      String?      @map("color_token") @db.VarChar(32)
  defaultLocation String?      @map("default_location") @db.VarChar(120)
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(3)
  version         Int          @default(0)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollments     UserCourse[]

  @@unique([id, userId], map: "courses_id_user_id_key")
  @@index([userId, archivedAt], map: "courses_user_id_idx")
  @@map("courses")
}

// Enrollment: attaches a reusable course identity to one term for one user
// (Slice B — academic foundation). "Course" fields (name/code/color/location)
// live on `Course`; this row's `archivedAt` controls whether the course is
// active within THIS term without affecting other terms or historical data.
model UserCourse {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  termId     String    @map("term_id") @db.Uuid
  courseId   String    @map("course_id") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  version    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  term       Term      @relation(fields: [termId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade)
  course     Course    @relation(fields: [courseId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, userId], map: "user_courses_id_user_id_key")
  @@unique([id, userId, termId], map: "user_courses_id_user_id_term_id_key")
  @@unique([userId, termId, courseId], map: "user_courses_user_id_term_id_course_id_key")
  @@index([userId, termId, archivedAt], map: "user_courses_user_id_term_id_idx")
  classSeries RecurringClassSeries[]
  @@map("user_courses")
}

enum ClassMeetingType {
  lecture
  lab
  tutorial

  @@map("class_meeting_type")
}

// A weekly class meeting pattern for one course enrollment (Slice C — class
// schedule and calendar). Deliberately narrower than iCalendar RRULE, per
// 03f §4.7: "weekdays" holds one or more unique days (0=Sunday..6=Saturday,
// matching JS Date#getDay and this app's Sunday week start), and the
// application expands bounded occurrences on demand — it never stores one
// row per future occurrence. "meetingType" extends 03f's reviewed columns;
// see the amendment note in that document.
model RecurringClassSeries {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  userCourseId  String            @map("user_course_id") @db.Uuid
  weekdays      Int[]
  localStartTime DateTime         @map("local_start_time") @db.Time()
  localEndTime  DateTime          @map("local_end_time") @db.Time()
  startsOn      DateTime          @map("starts_on") @db.Date
  endsOn        DateTime          @map("ends_on") @db.Date
  timeZone      String            @map("time_zone") @db.VarChar(64)
  location      String?           @db.VarChar(120)
  meetingType   ClassMeetingType  @map("meeting_type")
  archivedAt    DateTime?         @map("archived_at") @db.Timestamptz(3)
  version       Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userCourse    UserCourse        @relation(fields: [userCourseId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, userId], map: "recurring_class_series_id_user_id_key")
  @@index([userId, userCourseId, startsOn, endsOn], map: "recurring_class_series_user_id_user_course_id_idx")
  @@map("recurring_class_series")
}

model UserProfile {
  userId            String      @id @map("user_id") @db.Uuid
  locale            String      @db.VarChar(8)
  timeZone          String      @map("time_zone") @db.VarChar(64)
  university        String?     @db.VarChar(120)
  universityId      String?     @map("university_id") @db.Uuid
  major             String?     @db.VarChar(120)
  completedAt       DateTime?   @map("completed_at") @db.Timestamptz(3)
  version           Int         @default(0)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  universityCatalog University? @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_profiles")
}

// Curated catalog of Saudi universities for the onboarding picker
// (Slice B — academic foundation). Read-only reference data: seeded and
// maintained via migrations, not through in-app CRUD.
model University {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr    String            @map("name_ar") @db.VarChar(160)
  nameEn    String            @map("name_en") @db.VarChar(160)
  shortName String            @map("short_name") @db.VarChar(32)
  logoPath  String?           @map("logo_path") @db.VarChar(255)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles  UserProfile[]
  terms     UniversityTerm[]
  breaks    UniversityBreak[]

  @@map("universities")
}

enum UniversityTermSlot {
  first
  second
  third
  summer

  @@map("university_term_slot")
}

// Official published academic-calendar entries for a university (Slice C —
// university catalog and calendars). Read-only reference data supplied by the
// owner via migrations; starts empty. Used only to pre-fill term-creation
// dates — never a dependency of the university-independent Term domain model.
model UniversityTerm {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String             @map("university_id") @db.Uuid
  academicYear Int                @map("academic_year")
  term         UniversityTermSlot
  startsOn     DateTime           @map("starts_on") @db.Date
  endsOn       DateTime?          @map("ends_on") @db.Date
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  university   University         @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([universityId, academicYear, term], map: "university_terms_university_id_academic_year_term_key")
  @@index([universityId, academicYear], map: "university_terms_university_id_idx")
  @@map("university_terms")
}

// Official recesses within a university's academic calendar (Slice C —
// university catalog and calendars). Read-only reference data supplied by the
// owner via migrations. Not consumed anywhere yet; Slice C's class-schedule
// feature will use it to hide occurrences during a break.
model UniversityBreak {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String     @map("university_id") @db.Uuid
  academicYear Int        @map("academic_year")
  nameAr       String     @map("name_ar") @db.VarChar(120)
  nameEn       String     @map("name_en") @db.VarChar(120)
  startsOn     DateTime   @map("starts_on") @db.Date
  endsOn       DateTime   @map("ends_on") @db.Date
  resumesOn    DateTime   @map("resumes_on") @db.Date
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([universityId, academicYear, nameEn], map: "university_breaks_university_id_academic_year_name_en_key")
  @@index([universityId, academicYear], map: "university_breaks_university_id_idx")
  @@map("university_breaks")
}

// Technical-only Sprint 0 compatibility record. This is not a product entity.
model FoundationHealthCheck {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  marker    String   @db.VarChar(64)

  @@map("_foundation_health_checks")
}
